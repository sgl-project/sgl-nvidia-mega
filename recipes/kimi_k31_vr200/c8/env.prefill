# Kimi K3.1 on VR200, c8 published point, prefill role: environment words (KEY=VALUE), as served, without site, launcher and benchmark-only words.
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_MODULE_LOADING=EAGER
FLASHINFER_TRTLLM_MOE_OVERLAP_RESERVED_SMS=16
MC_FORCE_MNNVL=1
NCCL_CUMEM_ENABLE=1
NCCL_IB_SL=1
NCCL_MNNVL_ENABLE=1
NCCL_NVLINK_UTIL_CENTRIC_SCHED_ENABLE=0
NCCL_NVLS_ENABLE=0
PYTORCH_ALLOC_CONF=expandable_segments:True
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
SGLANG_CUSTOM_ALL_REDUCE_V2_MAX_SIZE_KB=32768
SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT=900
SGLANG_DISAGGREGATION_WAITING_TIMEOUT=900
SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=0
SGLANG_K3_AR_FUSION=1
SGLANG_K3_AR_LARGE_PULL_TUNING=1
SGLANG_MOONCAKE_CUSTOM_MEM_POOL=NVLINK
SGLANG_OPT_DFLASH_FUSED_SELECTOR=0
SGLANG_OPT_USE_CUSTOM_ALL_REDUCE_V2=1
SGLANG_RUST_BUILD_MODE=never
SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND=python
