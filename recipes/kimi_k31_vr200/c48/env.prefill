# Kimi K3.1 on VR200, c48 published point, prefill role: environment words (KEY=VALUE), as served, without site, launcher and benchmark-only words.
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_MODULE_LOADING=EAGER
FLASHINFER_TRTLLM_MOE_OVERLAP_RESERVED_SMS=16
MC_FORCE_MNNVL=1
NCCL_CUMEM_ENABLE=1
NCCL_IB_SL=1
NCCL_MNNVL_ENABLE=1
NCCL_NVLINK_UTIL_CENTRIC_SCHED_ENABLE=0
NCCL_NVLS_ENABLE=0
PYTHONPATH=/sgl-workspace/sglang/python
PYTORCH_ALLOC_CONF=expandable_segments:False
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
SGLANG_CUSTOM_ALL_REDUCE_V2_MAX_SIZE_KB=32768
SGLANG_DISAGGREGATION_BOOTSTRAP_TIMEOUT=900
SGLANG_DISAGGREGATION_WAITING_TIMEOUT=900
SGLANG_DSA_MQA_LOGITS_FREE_MEM_FRACTION=0.1
SGLANG_ENABLE_K3_SM107=1
SGLANG_ENABLE_PRIMS_TS_SM107=1
SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=0
SGLANG_K31_KDA_CONV_BLOCK_N=512
SGLANG_K31_KDA_H_PREFETCH=1
SGLANG_K31_KDA_QKV_PREP=1
SGLANG_K31_KDA_SEGSCAN=8
SGLANG_K31_KDA_TUNE_PIN=1
SGLANG_K31_PF_CUSTOM_AG=1
SGLANG_K31_PRIMS_TS_LISSUE=u16
SGLANG_K3_AR_FUSION=1
SGLANG_MOONCAKE_CUSTOM_MEM_POOL=NVLINK
SGLANG_NUMA_BIND_V2=0
SGLANG_OPT_USE_CUSTOM_ALL_REDUCE_V2=1
SGLANG_RUST_BUILD_MODE=never
SGLANG_UNIFIED_RADIX_TREE_CORE_BACKEND=python
K31P_HCBUDGET=1
K31P_HCBUDGET_TRIM=1
